# Create .env with scripts/setup_instance.py; never commit or print it.
COMPOSE_PROJECT_NAME=babata-user
CODEX_USER_ID=user
TOKYO_CODEX_VERSION=0.160.0
# setup_instance.py supplies the absolute path on the deployment host.
BABATA_SECCOMP_PROFILE=/absolute/path/to/babata/deploy/security/seccomp-native.json
LLM_PROVIDER=openai
LLM_API_STYLE=responses
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
TOKYO_NATIVE_MEMORIES=true
TOKYO_MEMORY_EXTRACT_MODEL=gpt-5.6-luna
TOKYO_MEMORY_CONSOLIDATION_MODEL=gpt-5.6-terra
TOKYO_MODEL_CONTEXT_WINDOW=0
TOKYO_AUTO_COMPACT_TOKEN_LIMIT=0
# For DeepSeek, setup_instance.py selects deepseek-flash for all three models,
# https://api.deepseek.com, context 1048576 and compaction limit 900000.
POSTGRES_PASSWORD=
ROKID_GATEWAY_TOKEN=
ROKID_GATEWAY_PORT=8081
ROKID_GATEWAY_TIMEOUT_SECONDS=90
# Optional TLS overlay only; leave unset when using an existing reverse proxy.
# HTTPS_PUBLISH_ADDRESS=127.0.0.1:8443
# TLS_CERTIFICATE_FILE=/outside/repository/fullchain.pem
# TLS_PRIVATE_KEY_FILE=/outside/repository/privkey.pem
